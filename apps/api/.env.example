# Cadena de conexión a PostgreSQL
DATABASE_URL="postgresql://postgres:CHANGE_ME@localhost:5432/barapp?schema=public"

# Secretos JWT (mínimo 32 caracteres). Genera valores únicos y aleatorios en producción.
JWT_ACCESS_SECRET="change-me-to-a-random-string-of-at-least-32-chars"
JWT_REFRESH_SECRET="change-me-to-a-different-random-string-of-32-chars"

NODE_ENV="development"

# Orígenes permitidos separados por coma (sin barra final)
CORS_ORIGIN="http://localhost:5173"

# Dominio para la cookie de refresh token; vacío en desarrollo local
COOKIE_DOMAIN=

# Puerto de escucha del backend
PORT=4000

# Solo se usan una vez para crear el primer administrador (scripts/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_USERNAME="admin"
BOOTSTRAP_ADMIN_PASSWORD="change-me-min-8-chars"
BOOTSTRAP_ADMIN_FULLNAME="Administrador"
