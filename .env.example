# Variables para docker-compose.yml (despliegue con Docker / Coolify)

POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
POSTGRES_DB=barapp

JWT_ACCESS_SECRET=change-me-to-a-random-string-of-at-least-32-chars
JWT_REFRESH_SECRET=change-me-to-a-different-random-string-of-32-chars

# Origen(es) permitidos por CORS, separados por coma, sin barra final
CORS_ORIGIN=http://localhost:8080
COOKIE_DOMAIN=

# URL pública de la API que el frontend usará (se hornea en el build estático)
VITE_API_URL=http://localhost:4000/api

# Solo para la primera ejecución del contenedor de la API (ver apps/api/scripts/bootstrap-admin.ts)
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=change-me-min-8-chars
BOOTSTRAP_ADMIN_FULLNAME=Administrador
